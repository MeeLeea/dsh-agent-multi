{
  // Standalone compiler options shared by the host and client faces. Mirrors
  // the deepseek-harness monorepo tsconfig.base.json minus its workspace path
  // aliases — cross-package imports here resolve through node_modules.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Self-references of this package resolve to its build outputs; the host
    // face emits first, so the client face typechecks against real files.
    "paths": {
      "dsh-agent-multi/types": ["./lib/types/index.d.ts"],
      "dsh-agent-multi/remote": ["./lib/typert.remote-client.d.ts"]
    }
  }
}
